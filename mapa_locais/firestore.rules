// Proposal requiring user approval before remote deployment.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized() {
      return request.auth != null && exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid));
    }
    function valid(d) {
      return d.keys().hasAll(['nome','categoria','cidade','avaliacao','distancia','horario','descricao','favorito'])
        && d.keys().hasOnly(['nome','categoria','cidade','avaliacao','distancia','horario','descricao','favorito'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.categoria is string && d.categoria.size() > 0 && d.categoria.size() <= 120
        && d.cidade in ['São Paulo','Campinas','Jundiaí']
        && d.avaliacao is number && d.avaliacao >= 0 && d.avaliacao <= 5
        && d.distancia is number && d.distancia >= 0
        && d.horario is string && d.horario.size() <= 120
        && d.descricao is string && d.descricao.size() <= 2000
        && d.favorito is bool;
    }
    match /locais/{id} {
      allow read, delete: if authorized();
      allow create, update: if authorized() && valid(request.resource.data);
    }
    // Authorization documents are managed only through trusted administration.
    match /{document=**} { allow read, write: if false; }
  }
}
